local function tween(obj, duration, props)
    local t = TweenService:Create(
        obj,
        TweenInfo.new(duration, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
        props
    )
    t:Play()
    return t
end

local function animateButton(button)
    local original = button.Size
    local normalColor = button.BackgroundColor3
    local hoverColor = Color3.fromRGB(45, 45, 52)

    button.MouseEnter:Connect(function()
        tween(button, 0.12, {
            BackgroundColor3 = hoverColor,
            Size = UDim2.new(1, -26, 0, 50)
        })
    end)

    button.MouseLeave:Connect(function()
        tween(button, 0.12, {
            BackgroundColor3 = normalColor,
            Size = original
        })
    end)

    button.Activated:Connect(function()
        tween(button, 0.08, {
            Size = UDim2.new(1, -34, 0, 44)
        })
        task.delay(0.08, function()
            if button.Parent then
                tween(button, 0.12, {Size = original})
            end
        end)
    end)
end

local function makeButton(text, y, callback)
    local b = Instance.new("TextButton")
    b.AutoButtonColor = true
    b.Size = UDim2.new(1, -30, 0, 48)
    b.Position = UDim2.fromOffset(15, y)
    b.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    b.BorderSizePixel = 0
    b.Font = Enum.Font.GothamSemibold
    b.Text = text
    b.TextColor3 = Color3.new(1, 1, 1)
    b.TextSize = 14
    b.Parent = frame

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 10)
    c.Parent = b

    b.MouseButton1Click:Connect(callback)
    animateButton(b)
    return b
end

local busy = false

local loading = Instance.new("Frame")
loading.Name = "Loading"
loading.AnchorPoint = Vector2.new(0.5, 0.5)
loading.Position = UDim2.fromScale(0.5, 0.88)
loading.Size = UDim2.fromOffset(12, 12)
loading.BackgroundColor3 = Color3.fromRGB(190, 30, 50)
loading.BackgroundTransparency = 1
loading.BorderSizePixel = 0
loading.Visible = false
loading.Parent = frame

local loadingCorner = Instance.new("UICorner")
loadingCorner.CornerRadius = UDim.new(1, 0)
loadingCorner.Parent = loading

local function showLoading()
    loading.Visible = true
    loading.BackgroundTransparency = 0
    loading.Size = UDim2.fromOffset(8, 8)

    tween(loading, 0.35, {
        Size = UDim2.fromOffset(18, 18)
    })

    task.spawn(function()
        while loading.Visible do
            tween(loading, 0.45, {
                Rotation = loading.Rotation + 180,
                BackgroundTransparency = 0.25
            })
            task.wait(0.45)
            if loading.Visible then
                tween(loading, 0.45, {
                    Rotation = loading.Rotation + 180,
                    BackgroundTransparency = 0
                })
            end
            task.wait(0.45)
        end
    end)
end

local function hideLoading()
    loading.Visible = false
end

local function runSelected(url)
    if busy then
        return
    end

    busy = true
    title.Text = "กำลังโหลด..."
    showLoading()
    tween(frame, 0.18, {
        BackgroundColor3 = Color3.fromRGB(24, 18, 22)
    })
    sub.Text = "กำลังเปิดสคริปต์ที่เลือก"

    for _, child in ipairs(frame:GetChildren()) do
        if child:IsA("TextButton") then
            child.Active = false
            pcall(function()
                child.Interactable = false
            end)
        end
    end


    local okHttp, source = pcall(function()
        return game:HttpGet(url)
    end)

    if not okHttp or type(source) ~= "string" or #source < 10 then
        busy = false
        hideLoading()
        title.Text = "KSS VD"
        sub.Text = "โหลดไม่สำเร็จ — ตรวจสอบ Console"
        warn("KSS VD Script Selector: HttpGet Error: " .. tostring(source))
        for _, child in ipairs(frame:GetChildren()) do
            if child:IsA("TextButton") then
                child.Active = true
                pcall(function()
                    child.Interactable = true
                end)
            end
        end
        return
    end

    local fn, compileErr = loadstring(source)
    if not fn then
        busy = false
        hideLoading()
        title.Text = "KSS VD"
        sub.Text = "Compile Error — ตรวจสอบ Console"
        warn("KSS VD Script Selector: Compile Error: " .. tostring(compileErr))
        for _, child in ipairs(frame:GetChildren()) do
            if child:IsA("TextButton") then
                child.Active = true
                pcall(function()
                    child.Interactable = true
                end)
            end
        end
        return
    end


    hideLoading()

    local closeTween = tween(frame, 0.22, {
        Size = UDim2.fromOffset(300, 170),
        BackgroundTransparency = 1,
        Position = UDim2.fromScale(0.5, 0.54)
    })
    tween(title, 0.15, {TextTransparency = 1})
    tween(sub, 0.15, {TextTransparency = 1})

    task.delay(0.23, function()
        if gui.Parent then
            gui:Destroy()
        end
    end)

    task.spawn(function()
        local okRun, runErr = pcall(fn)
        if not okRun then
            warn("KSS VD Script Selector: Runtime Error: " .. tostring(runErr))
        end
    end)
end

makeButton("Script 1  •  KSS VD", 80, function()
